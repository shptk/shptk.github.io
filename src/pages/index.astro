---
import { type CollectionEntry, getCollection } from "astro:content";
import PostPreview from "@/components/blog/PostPreview.astro";
import LangBlock from "@/components/LangBlock.astro";
import Note from "@/components/note/Note.astro";
import SocialList from "@/components/SocialList.astro";
import T from "@/components/T.astro";
import { getAllPosts } from "@/data/post";
import { t } from "@/i18n/ui";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";

// Posts
const MAX_POSTS = 10;
const allPosts = await getAllPosts();
const allPostsByDate = allPosts.sort(collectionDateSort) as CollectionEntry<"post">[];
const latestPosts = allPostsByDate.slice(0, MAX_POSTS);

// Pinned Posts, set to a max of 3;
const MAX_PINNED_POSTS = 3;
const pinnedPosts = allPostsByDate.filter((p) => p.data.pinned).slice(0, MAX_PINNED_POSTS);

// Notes
const MAX_NOTES = 5;
const allNotes = await getCollection("note");
const latestNotes = allNotes
	.sort(collectionDateSort)
	.slice(0, MAX_NOTES) as CollectionEntry<"note">[];
---

<PageLayout meta={{ title: t("en", "home.title"), titleDe: t("de", "home.title") }}>
	<section>
		<h1 class="title mb-12"><T tKey="home.greeting" /></h1>
		<LangBlock>
			<Fragment slot="en">
				<div class="prose prose-cactus mb-8">
					<p class="text-lg">
						I'm a <strong>Platform Engineer</strong> based in Bangalore, India, specializing in building
						and scaling cloud-native infrastructure across AWS, GCP, and Azure.
					</p>
					<p>
						With 2.5+ years of experience in DevOps and Platform Engineering, I've helped migrate
						legacy architectures to modern microservices, built 40+ Terraform modules, automated
						Kubernetes cluster optimizations, and even created AI-powered infrastructure cost
						optimization tools.
					</p>
					<p>
						When I'm not architecting infrastructure or debugging production issues at 3 AM, I'm
						probably exploring new cloud technologies, exploring opensource, learning system design,
						or earning certifications (recently got my GCP Professional Cloud Architect!). Currently
						also getting my hands dirty with Golang.
					</p>
					<div class="not-prose">
						<a href="/about/" class="cactus-link mr-4 inline-block">Learn more about me →</a>
						<a href="/experience/" class="cactus-link inline-block">View my experience →</a>
					</div>
				</div>
			</Fragment>
			<Fragment slot="de">
				<div class="prose prose-cactus mb-8">
					<p class="text-lg">
						Ich bin <strong>Platform Engineer</strong> in Bangalore (Indien) und darauf spezialisiert,
						cloud-native Infrastruktur auf AWS, GCP und Azure aufzubauen und zu skalieren.
					</p>
					<p>
						Mit über 2,5 Jahren Erfahrung in DevOps und Platform Engineering habe ich
						Legacy-Architekturen auf moderne Microservices migriert, mehr als 40 Terraform-Module
						gebaut, die Optimierung von Kubernetes-Clustern automatisiert und KI-gestützte Tools zur
						Kostenoptimierung von Infrastruktur entwickelt.
					</p>
					<p>
						Wenn ich gerade keine Infrastruktur entwerfe oder um drei Uhr morgens Produktionsprobleme
						debugge, probiere ich neue Cloud-Technologien aus, stöbere in Open Source, lerne System
						Design oder mache Zertifizierungen — zuletzt den GCP Professional Cloud Architect.
						Aktuell arbeite ich mich außerdem in Go ein.
					</p>
					<div class="not-prose">
						<a href="/about/" class="cactus-link mr-4 inline-block">Mehr über mich →</a>
						<a href="/experience/" class="cactus-link inline-block">Meine Erfahrung ansehen →</a>
					</div>
				</div>
			</Fragment>
		</LangBlock>
		<SocialList />
	</section>
	{
		pinnedPosts.length > 0 && (
			<section class="mt-16">
				<h2 class="title mb-6 text-xl">
					<T tKey="home.pinnedPosts" />
				</h2>
				<ul class="space-y-4" role="list">
					{pinnedPosts.map((p) => (
						<li class="grid gap-1 sm:grid-cols-[auto_1fr]">
							<PostPreview post={p} />
						</li>
					))}
				</ul>
			</section>
		)
	}
	<section class="mt-16">
		<h2 class="title text-accent mb-6 text-xl">
			<a href="/posts/"><T tKey="home.posts" /></a>
		</h2>
		<ul class="space-y-4" role="list">
			{
				latestPosts.map((p) => (
					<li class="grid gap-1 sm:grid-cols-[auto_1fr]">
						<PostPreview post={p} />
					</li>
				))
			}
		</ul>
	</section>
	{
		latestNotes.length > 0 && (
			<section class="mt-16">
				<h2 class="title text-accent mb-6 text-xl">
					<a href="/notes/">
						<T tKey="home.notes" />
					</a>
				</h2>
				<ul class="space-y-6" role="list">
					{latestNotes.map((note) => (
						<li>
							<Note note={note} as="h3" isPreview />
						</li>
					))}
				</ul>
			</section>
		)
	}
</PageLayout>
