---
import { type CollectionEntry, getCollection } from "astro:content";
import PostPreview from "@/components/blog/PostPreview.astro";
import LangBlock from "@/components/LangBlock.astro";
import Note from "@/components/note/Note.astro";
import SocialList from "@/components/SocialList.astro";
import T from "@/components/T.astro";
import { getAllPosts } from "@/data/post";
import { t } from "@/i18n/ui";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";

// Posts
const MAX_POSTS = 10;
const allPosts = await getAllPosts();
const allPostsByDate = allPosts.sort(collectionDateSort) as CollectionEntry<"post">[];
const latestPosts = allPostsByDate.slice(0, MAX_POSTS);

// Pinned Posts, set to a max of 3;
const MAX_PINNED_POSTS = 3;
const pinnedPosts = allPostsByDate.filter((p) => p.data.pinned).slice(0, MAX_PINNED_POSTS);

// Notes
const MAX_NOTES = 5;
const allNotes = await getCollection("note");
const latestNotes = allNotes
	.sort(collectionDateSort)
	.slice(0, MAX_NOTES) as CollectionEntry<"note">[];
---

<PageLayout meta={{ title: t("en", "home.title"), titleDe: t("de", "home.title") }}>
	<section>
		<h1 class="title mb-12"><T tKey="home.greeting" /></h1>
		<LangBlock>
			<Fragment slot="en">
				<div class="prose prose-cactus mb-8">
					<p class="text-lg">
						I'm a <strong>Platform Engineer</strong>, currently in Germany. I build and run cloud
						infrastructure across AWS, GCP, and Azure — Terraform, Kubernetes, CI/CD, and observability.
					</p>
					<p>
						3+ years in DevOps and Platform Engineering, most recently at Facets.cloud. I also build
						tooling that applies AI to infrastructure work, including an MCP server and a Claude.ai skill
						for cost optimization.
					</p>
					<p>I'm open to Platform Engineering, DevOps and Cloud Infrastructure roles in Germany.</p>
					<div class="not-prose">
						<a href="/about/" class="cactus-link mr-4 inline-block">Learn more about me →</a>
						<a href="/experience/" class="cactus-link inline-block">View my experience →</a>
					</div>
				</div>
			</Fragment>
			<Fragment slot="de">
				<div class="prose prose-cactus mb-8">
					<p class="text-lg">
						Ich bin <strong>Platform Engineer</strong> und derzeit in Deutschland. Ich baue und betreibe
						cloud-native Infrastruktur auf AWS, GCP und Azure — Terraform, Kubernetes, CI/CD und
						Observability.
					</p>
					<p>
						Über 3 Jahre in DevOps und Platform Engineering, zuletzt bei Facets.cloud. Außerdem baue ich
						Tools, die KI auf Infrastrukturarbeit anwenden, darunter einen MCP-Server und einen
						Claude.ai-Skill zur Kostenoptimierung.
					</p>
					<p>
						Ich bin offen für Rollen in Platform Engineering, DevOps und Cloud-Infrastruktur in
						Deutschland.
					</p>
					<div class="not-prose">
						<a href="/about/" class="cactus-link mr-4 inline-block">Mehr über mich →</a>
						<a href="/experience/" class="cactus-link inline-block">Meine Erfahrung ansehen →</a>
					</div>
				</div>
			</Fragment>
		</LangBlock>
		<SocialList />
	</section>
	<section class="mt-16">
		<h2 class="title text-accent mb-6 text-xl">
			<a href="https://links.shashwat.de/" rel="noreferrer" target="_blank">
				<T tKey="home.links" />
			</a>
		</h2>
		<LangBlock>
			<Fragment slot="en">
				<p>
					Every profile and project in one place — GitHub, LinkedIn, blogs and more.{" "}
					<a
						class="cactus-link inline-block"
						href="https://links.shashwat.de/"
						rel="noreferrer"
						target="_blank">links.shashwat.de →</a
					>
				</p>
			</Fragment>
			<Fragment slot="de">
				<p>
					Alle Profile und Projekte an einem Ort — GitHub, LinkedIn, Blogs und mehr.{" "}
					<a
						class="cactus-link inline-block"
						href="https://links.shashwat.de/"
						rel="noreferrer"
						target="_blank">links.shashwat.de →</a
					>
				</p>
			</Fragment>
		</LangBlock>
	</section>
	{
		pinnedPosts.length > 0 && (
			<section class="mt-16">
				<h2 class="title mb-6 text-xl">
					<T tKey="home.pinnedPosts" />
				</h2>
				<ul class="space-y-4" role="list">
					{pinnedPosts.map((p) => (
						<li class="grid gap-1 sm:grid-cols-[auto_1fr]">
							<PostPreview post={p} />
						</li>
					))}
				</ul>
			</section>
		)
	}
	<section class="mt-16">
		<h2 class="title text-accent mb-6 text-xl">
			<a href="/posts/"><T tKey="home.posts" /></a>
		</h2>
		<ul class="space-y-4" role="list">
			{
				latestPosts.map((p) => (
					<li class="grid gap-1 sm:grid-cols-[auto_1fr]">
						<PostPreview post={p} />
					</li>
				))
			}
		</ul>
	</section>
	{
		latestNotes.length > 0 && (
			<section class="mt-16">
				<h2 class="title text-accent mb-6 text-xl">
					<a href="/notes/">
						<T tKey="home.notes" />
					</a>
				</h2>
				<ul class="space-y-6" role="list">
					{latestNotes.map((note) => (
						<li>
							<Note note={note} as="h3" isPreview />
						</li>
					))}
				</ul>
			</section>
		)
	}
</PageLayout>
