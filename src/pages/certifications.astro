---
import LangBlock from "@/components/LangBlock.astro";
import T from "@/components/T.astro";
import { t } from "@/i18n/ui";
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description:
		"Professional certifications in Cloud Architecture, Linux Administration, and Container Orchestration",
	title: t("en", "page.certifications"),
	titleDe: t("de", "page.certifications"),
};

const certifications = [
	{
		title: "Google Certified Professional Cloud Architect",
		issuer: "Google Cloud",
		date: "December 2025",
		credlyUrl: "https://www.credly.com/badges/feeccd04-0321-4da9-8a5b-9f5c8f2052c4/public_url",
		icon: "☁️",
		description:
			"Demonstrates proficiency in designing, developing, and managing robust, secure, scalable, highly available, and dynamic solutions on Google Cloud Platform.",
		skills: [
			"GCP Architecture",
			"Cloud Solutions",
			"Infrastructure Design",
			"Security & Compliance",
		],
	},
	{
		title: "Red Hat Certified Engineer (RHCE)",
		issuer: "Red Hat",
		date: "November 2021",
		credlyUrl:
			"https://www.credly.com/badges/cfe04063-7c3a-4009-9716-bbf5ec0ce0e9/linked_in_profile",
		icon: "🔴",
		description:
			"Advanced certification focused on Ansible automation, configuration management, and system automation.",
		skills: ["Ansible", "Automation", "Configuration Management", "System Administration"],
	},
	{
		title: "Red Hat Certified System Administrator (RHCSA)",
		issuer: "Red Hat",
		date: "February 2021",
		credlyUrl:
			"https://www.credly.com/badges/7dc13584-f933-4587-80e3-f8e574db95a9/linked_in_profile",
		icon: "🐧",
		description:
			"Foundation certification covering essential Linux system administration tasks and advanced Linux concepts.",
		skills: ["Linux Administration", "System Management", "Troubleshooting", "Security"],
	},
	{
		title: "Red Hat Certified Specialist in Containers and Kubernetes",
		issuer: "Red Hat",
		date: "February 2023",
		credlyUrl:
			"https://www.credly.com/badges/252121dc-f1ac-4ebf-ae64-c58ec3abc345/linked_in_profile",
		icon: "🐳",
		description:
			"Specialized certification in container orchestration, Kubernetes administration, and cloud-native application deployment.",
		skills: ["Kubernetes", "Container Orchestration", "OpenShift", "Cloud Native"],
	},
];
---

<PageLayout meta={meta}>
	<h1 class="title mb-12"><T tKey="certifications.heading" /></h1>
	<LangBlock>
		<Fragment slot="en">
			<div class="prose prose-sm prose-cactus max-w-none">
				<p class="mb-8 text-lg">
					I'm a strong believer in continuous learning and validating knowledge through
					certifications. Here are the credentials I've earned so far on my journey.
				</p>

				<!-- Certifications List -->
				<div class="not-prose space-y-8">
					{
						certifications.map((cert) => (
							<div class="border-accent-2 rounded-lg border p-6 transition-shadow hover:shadow-lg">
								<div class="flex items-start gap-4">
									<span class="flex-shrink-0 text-4xl">{cert.icon}</span>
									<div class="flex-grow">
										<div class="mb-2 flex items-start justify-between">
											<h2 class="!mt-0 text-xl font-bold">{cert.title}</h2>
											<a
												class="cactus-link ml-4 text-sm whitespace-nowrap"
												href={cert.credlyUrl}
												rel="noreferrer"
												target="_blank"
											>
												View Badge →
											</a>
										</div>
										<p class="text-accent-2 mb-3 text-sm font-semibold">
											{cert.issuer} • {cert.date}
										</p>
										<p class="mb-4">{cert.description}</p>
										<div class="flex flex-wrap gap-2">
											{cert.skills.map((skill) => (
												<span class="bg-accent-2/10 text-accent-2 inline-block rounded-full px-3 py-1 text-xs font-semibold">
													{skill}
												</span>
											))}
										</div>
									</div>
								</div>
							</div>
						))
					}
				</div>

				<!-- Why Certifications Matter -->
				<div class="border-accent-2 mt-12 border-t-2 pt-8">
					<h2>Why Certifications?</h2>
					<p>
						For me, certifications aren't just badges to collect - they're structured learning paths
						that force me to dive deep into technologies and validate my understanding. Each
						certification represents hundreds of hours of study, hands-on labs, and real-world
						application.
					</p>
					<p>
						More importantly, they push me to learn things systematically rather than just picking
						up bits and pieces from Stack Overflow (though let's be honest, we all do that too 😄).
					</p>
				</div>

				<!-- What's Next -->
				<div class="border-accent-2 mt-12 border-t-2 pt-8">
					<h2>What's Next? 🎯</h2>
					<p>I'm currently eyeing a few more certifications to expand my expertise:</p>
					<ul class="list-inside list-disc space-y-2">
						<li>
							<strong>AWS Certified Solutions Architect - Professional:</strong> To deepen my AWS architecture
							knowledge
						</li>
						<li>
							<strong>Certified Kubernetes Administrator (CKA):</strong> Because you can never know Kubernetes
							well enough
						</li>
						<li>
							<strong>HashiCorp Certified: Terraform Associate:</strong> To formalize my Terraform expertise
						</li>
					</ul>
					<p class="mt-4">
						Follow along on <a
							class="cactus-link inline-block"
							href="https://www.linkedin.com/in/shptk/"
							rel="noreferrer"
							target="_blank">LinkedIn</a
						> to see when I add these to my collection!
					</p>
				</div>
			</div>
		</Fragment>
		{
			/* TODO(de): add <Fragment slot="de"> with the German version of this block.
		    Until it exists, LangBlock renders the English copy above in both locales. */
		}
	</LangBlock>
</PageLayout>
