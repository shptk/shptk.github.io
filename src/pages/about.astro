---
import LangBlock from "@/components/LangBlock.astro";
import T from "@/components/T.astro";
import { t } from "@/i18n/ui";
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description:
		"Platform Engineer, currently in Germany, working on cloud infrastructure across AWS, GCP, and Azure.",
	title: t("en", "page.about"),
	titleDe: t("de", "page.about"),
};
---

<PageLayout meta={meta}>
	<h1 class="title mb-12"><T tKey="about.heading" /></h1>
	<LangBlock>
		<Fragment slot="en">
			<div class="prose prose-sm prose-cactus max-w-none">
				<p>
					I'm Shashwat, a Platform Engineer, currently in Germany. I build and run cloud infrastructure
					across AWS, GCP, and Azure — Terraform modules, Kubernetes optimization, CI/CD, and
					observability with Prometheus and Grafana.
				</p>
				<p>
					3+ years in DevOps and Platform Engineering, most recently at <a
						class="cactus-link inline-block"
						href="https://facets.cloud"
						rel="noreferrer"
						target="_blank">Facets.cloud</a
					>. I also build tooling that applies AI to infrastructure work, including an MCP server and
					a Claude.ai skill for cost optimization.
				</p>
				<p>
					Certifications: Google Cloud Professional Cloud Architect, Red Hat Certified Specialist in
					Containers &amp; Kubernetes, RHCE, RHCSA.
				</p>
				<p>I'm open to Platform Engineering, DevOps and Cloud Infrastructure roles in Germany.</p>

				<h2>Contact</h2>
				<ul class="list-inside list-disc" role="list">
					<li>
						Email: <a class="cactus-link inline-block" href="mailto:shashwatpathak100@gmail.com"
							>shashwatpathak100@gmail.com</a>
					</li>
					<li>
						GitHub: <a
							class="cactus-link inline-block"
							href="https://github.com/shptk"
							rel="noreferrer"
							target="_blank">@shptk</a>
					</li>
					<li>
						LinkedIn: <a
							class="cactus-link inline-block"
							href="https://www.linkedin.com/in/shptk/"
							rel="noreferrer"
							target="_blank">in/shptk</a>
					</li>
					<li>Location: Germany 🇩🇪</li>
				</ul>

				<div class="not-prose mt-8">
					<a
						href="/Shashwat-Pathak-Resume.pdf"
						class="bg-accent-2 text-bgColor inline-block rounded-lg px-6 py-3 font-semibold transition-opacity hover:opacity-90"
						download
					>
						📄 Download My Resume
					</a>
				</div>
			</div>
		</Fragment>
		<Fragment slot="de">
			<div class="prose prose-sm prose-cactus max-w-none">
				<p>
					Ich bin Shashwat, Platform Engineer und derzeit in Deutschland. Ich baue und betreibe
					Cloud-Infrastruktur auf AWS, GCP und Azure — Terraform-Module, Kubernetes-Optimierung,
					CI/CD und Observability mit Prometheus und Grafana.
				</p>
				<p>
					Über 3 Jahre in DevOps und Platform Engineering, zuletzt bei <a
						class="cactus-link inline-block"
						href="https://facets.cloud"
						rel="noreferrer"
						target="_blank">Facets.cloud</a
					>. Außerdem baue ich Tools, die KI auf Infrastrukturarbeit anwenden, darunter einen
					MCP-Server und einen Claude.ai-Skill zur Kostenoptimierung.
				</p>
				<p>
					Zertifizierungen: Google Cloud Professional Cloud Architect, Red Hat Certified Specialist
					in Containers &amp; Kubernetes, RHCE, RHCSA.
				</p>
				<p>
					Ich bin offen für Rollen in Platform Engineering, DevOps und Cloud-Infrastruktur in
					Deutschland.
				</p>

				<h2>Kontakt</h2>
				<ul class="list-inside list-disc" role="list">
					<li>
						E-Mail: <a class="cactus-link inline-block" href="mailto:shashwatpathak100@gmail.com"
							>shashwatpathak100@gmail.com</a>
					</li>
					<li>
						GitHub: <a
							class="cactus-link inline-block"
							href="https://github.com/shptk"
							rel="noreferrer"
							target="_blank">@shptk</a>
					</li>
					<li>
						LinkedIn: <a
							class="cactus-link inline-block"
							href="https://www.linkedin.com/in/shptk/"
							rel="noreferrer"
							target="_blank">in/shptk</a>
					</li>
					<li>Standort: Deutschland 🇩🇪</li>
				</ul>

				<div class="not-prose mt-8">
					<a
						href="/Shashwat-Pathak-Resume.pdf"
						class="bg-accent-2 text-bgColor inline-block rounded-lg px-6 py-3 font-semibold transition-opacity hover:opacity-90"
						download
					>
						📄 Lebenslauf herunterladen
					</a>
				</div>
			</div>
		</Fragment>
	</LangBlock>
</PageLayout>
