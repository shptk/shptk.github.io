---
import T from "@/components/T.astro";
import { t } from "@/i18n/ui";
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description: t("de", "404.description"),
	title: t("en", "404.title"),
	titleDe: t("de", "404.title"),
};
---

<PageLayout meta={meta}>
	<h1 class="title mb-12"><T tKey="404.heading" /></h1>
	<p class="mb-8"><T tKey="404.body" /></p>
</PageLayout>
