---
import LangBlock from "@/components/LangBlock.astro";
import T from "@/components/T.astro";
import { t } from "@/i18n/ui";
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description:
		"DevOps and Platform Engineering, 2022–2026: multi-cloud infrastructure, Kubernetes and Terraform.",
	title: t("en", "page.experience"),
	titleDe: t("de", "page.experience"),
};
---

<PageLayout meta={meta}>
	<h1 class="title mb-12"><T tKey="experience.heading" /></h1>
	<LangBlock>
		<Fragment slot="en">
			<div class="prose prose-sm prose-cactus max-w-none">
				<!-- Facets.cloud - Forward Deployed Engineer -->
				<div class="border-accent-2 mb-12 border-l-4 pl-6">
					<h2 class="!mt-0">Forward Deployed Engineer</h2>
					<p class="text-accent-2 mb-2 text-sm font-semibold">
						<a class="cactus-link" href="https://facets.cloud" rel="noreferrer" target="_blank"
							>Facets.cloud</a
						> • Full-time • Bangalore, India
					</p>
					<p class="mb-4 text-sm italic">June 2025 - July 2026</p>

					<p>
						Platform engineering in direct contact with customers — owning engagements end to end,
						from cloud discovery through onboarding to migration.
					</p>

					<h3 class="text-base">Highlights:</h3>
					<ul class="list-inside list-disc space-y-2">
						<li>
							<strong>Customer Onboarding at Scale:</strong> Onboarded 3+ large-scale customers by redesigning
							their multi-cloud infrastructure. Each engagement involved reverse-engineering complex existing
							setups and integrating them with our product.
						</li>
						<li>
							<strong>Knowledge Transfer:</strong> Trained the entire Customer Success team to handle
							customer support, reducing the load on Platform Engineers. Built documentation and ran hands-on
							workshops.
						</li>
						<li>
							<strong>AI-Powered Cost Optimization:</strong> Developed a knowledge pool of infrastructure
							cost optimization practices as an internal MCP server and Claude.ai skill, enabling AI-driven
							analysis of customer infrastructure.
						</li>
						<li>
							<strong>Infrastructure Blueprints:</strong> Created reusable infrastructure blueprints as
							part of customer onboarding, so complex multi-cloud setups could be provisioned and handed
							over following DevOps practices.
						</li>
					</ul>

					<p class="mt-4">
						<strong>Tech Stack:</strong> AWS, GCP, Azure, Kubernetes, Terraform, Python, MCP (Model Context
						Protocol)
					</p>
				</div>

				<!-- Facets.cloud - Platform Engineer -->
				<div class="border-accent-2 mb-12 border-l-4 pl-6">
					<h2 class="!mt-0">Platform Engineer</h2>
					<p class="text-accent-2 mb-2 text-sm font-semibold">
						<a class="cactus-link" href="https://facets.cloud" rel="noreferrer" target="_blank"
							>Facets.cloud</a
						> • Full-time • Bangalore, India
					</p>
					<p class="mb-4 text-sm italic">June 2023 - May 2025</p>

					<p>
						Converted from the internship into a full-time engineering role on the multi-cloud
						provisioning platform, covering infrastructure delivery and customer support.
					</p>

					<h3 class="text-base">Highlights:</h3>
					<ul class="list-inside list-disc space-y-2">
						<li>
							<strong>Terraform Module Factory:</strong> Developed 40+ Terraform modules (multi-cloud
							+ Kubernetes) based on customer requirements. These modules became core product extensions
							used across multiple deployments.
						</li>
						<li>
							<strong>Observability Overhaul:</strong> Rebuilt Prometheus queries, Grafana dashboards,
							and the alerting system with Slack integration.
						</li>
						<li>
							<strong>Kubernetes Migration Automation:</strong> Created Python migration templates for
							EKS, AKS, and GKE control plane version upgrades, replacing a manual, error-prone process
							with repeatable upgrades.
						</li>
						<li>
							<strong>Production Support:</strong> Supported customers on production-grade cluster optimizations,
							networking debugging, and infrastructure troubleshooting.
						</li>
						<li>
							<strong>ISO 27001 Compliance:</strong> Analysed and upgraded production infrastructure and
							security controls toward ISO 27001 certification.
						</li>
					</ul>

					<p class="mt-4">
						<strong>Tech Stack:</strong> AWS, GCP, Azure, Kubernetes, Python, Prometheus, Grafana, Loki,
						MongoDB
					</p>
				</div>

				<!-- Facets.cloud - DevOps Intern -->
				<div class="border-accent-2 mb-12 border-l-4 pl-6">
					<h2 class="!mt-0">DevOps Intern</h2>
					<p class="text-accent-2 mb-2 text-sm font-semibold">
						<a class="cactus-link" href="https://facets.cloud" rel="noreferrer" target="_blank"
							>Facets.cloud</a
						> • Remote Internship
					</p>
					<p class="mb-4 text-sm italic">Feb 2023 - June 2023</p>

					<p>
						Internship on the platform team, working with Kubernetes, Helm and production
						infrastructure. Converted to a full-time role in June 2023.
					</p>

					<h3 class="text-base">Highlights:</h3>
					<ul class="list-inside list-disc space-y-2">
						<li>
							<strong>Helm Chart Development:</strong> Developed and published multiple Helm charts as
							part of product extensions.
						</li>
						<li>
							<strong>Cluster Efficiency Automation:</strong> Built a Python metrics scraper that pulled
							custom Prometheus metrics from 100+ customer clusters in parallel using multi-threading.
							The tool analysed cluster efficiency and utilisation and suggested optimizations to improve
							resource usage.
						</li>
					</ul>

					<p class="mt-4">
						<strong>Tech Stack:</strong> AWS, Python, Kubernetes, Helm, Terraform
					</p>
				</div>

				<!-- Opslyft - DevOps Intern -->
				<div class="border-accent-2 mb-12 border-l-4 pl-6">
					<h2 class="!mt-0">DevOps Intern</h2>
					<p class="text-accent-2 mb-2 text-sm font-semibold">
						<a class="cactus-link" href="https://opslyft.com" rel="noreferrer" target="_blank"
							>Opslyft</a
						> • Remote Internship
					</p>
					<p class="mb-4 text-sm italic">April 2022 - Feb 2023</p>

					<p>
						First DevOps role, at a cloud cost management company: cloud migration, CI/CD and cost
						optimization.
					</p>

					<h3 class="text-base">Highlights:</h3>
					<ul class="list-inside list-disc space-y-2">
						<li>
							<strong>Modernization Migration:</strong> Migrated a VM-based legacy monolith to containerized
							microservices on AWS ECS Fargate, and moved logging from CloudWatch to Loki using Fluent
							Bit sidecars, cutting total cloud costs by 30%.
						</li>
						<li>
							<strong>CI/CD Transformation:</strong> Migrated legacy Jenkins pipelines to GitHub Actions,
							improving the speed and maintainability of CI/CD pipelines.
						</li>
					</ul>

					<p class="mt-4">
						<strong>Tech Stack:</strong> AWS ECS Fargate, GitHub Actions, Jenkins CI/CD, AWS EventBridge
					</p>
				</div>

				<!-- Education -->
				<div class="border-accent-2 mt-16 border-t-2 pt-8">
					<h2>Education</h2>
					<div class="border-accent-2 border-l-4 pl-6">
						<h3 class="!mt-0">B.Tech in Computer Science</h3>
						<p class="text-accent-2 mb-2 text-sm font-semibold">
							SRMS CET, Bareilly • Affiliated to Abdul Kalam Tech. University (A.K.T.U)
						</p>
						<p class="text-sm italic">July 2019 - July 2023</p>
					</div>
				</div>
			</div>
		</Fragment>
		<Fragment slot="de">
			<div class="prose prose-sm prose-cactus max-w-none">
				<!-- Facets.cloud - Forward Deployed Engineer -->
				<div class="border-accent-2 mb-12 border-l-4 pl-6">
					<h2 class="!mt-0">Forward Deployed Engineer</h2>
					<p class="text-accent-2 mb-2 text-sm font-semibold">
						<a class="cactus-link" href="https://facets.cloud" rel="noreferrer" target="_blank"
							>Facets.cloud</a
						> • Vollzeit • Bangalore, Indien
					</p>
					<p class="mb-4 text-sm italic">Juni 2025 – Juli 2026</p>

					<p>
						Platform Engineering in direkter Zusammenarbeit mit Kunden — Projekte end-to-end
						verantwortet, von der Cloud-Analyse über das Onboarding bis zur Migration.
					</p>

					<h3 class="text-base">Schwerpunkte:</h3>
					<ul class="list-inside list-disc space-y-2">
						<li>
							<strong>Kunden-Onboarding im großen Maßstab:</strong> Mehr als drei Großkunden onboardet
							und dabei ihre Multi-Cloud-Infrastruktur neu konzipiert. Jedes Projekt bedeutete, komplexe
							bestehende Setups zu analysieren und in unser Produkt zu integrieren.
						</li>
						<li>
							<strong>Wissenstransfer:</strong> Das gesamte Customer-Success-Team im Kundensupport
							geschult und damit die Last auf den Platform Engineers reduziert. Dazu Dokumentation
							erstellt und praxisnahe Workshops durchgeführt.
						</li>
						<li>
							<strong>KI-gestützte Kostenoptimierung:</strong> Best Practices zur Kostenoptimierung von
							Infrastruktur als internen MCP-Server und Claude.ai-Skill gebündelt, was KI-gestützte Analysen
							der Kundeninfrastruktur ermöglichte.
						</li>
						<li>
							<strong>Infrastructure Blueprints:</strong> Wiederverwendbare Infrastruktur-Blueprints als
							Teil des Kunden-Onboardings entwickelt, um komplexe Multi-Cloud-Setups nach DevOps-Best-Practices
							bereitzustellen und zu übergeben.
						</li>
					</ul>

					<p class="mt-4">
						<strong>Tech-Stack:</strong> AWS, GCP, Azure, Kubernetes, Terraform, Python, MCP (Model Context
						Protocol)
					</p>
				</div>

				<!-- Facets.cloud - Platform Engineer -->
				<div class="border-accent-2 mb-12 border-l-4 pl-6">
					<h2 class="!mt-0">Platform Engineer</h2>
					<p class="text-accent-2 mb-2 text-sm font-semibold">
						<a class="cactus-link" href="https://facets.cloud" rel="noreferrer" target="_blank"
							>Facets.cloud</a
						> • Vollzeit • Bangalore, Indien
					</p>
					<p class="mb-4 text-sm italic">Juni 2023 – Mai 2025</p>

					<p>
						Nach dem Praktikum in die Festanstellung übernommen, mit Fokus auf
						Multi-Cloud-Infrastruktur und Kundensupport.
					</p>

					<h3 class="text-base">Schwerpunkte:</h3>
					<ul class="list-inside list-disc space-y-2">
						<li>
							<strong>Terraform-Modul-Fabrik:</strong> Über 40 Terraform-Module (Multi-Cloud und
							Kubernetes) nach Kundenanforderungen entwickelt. Diese Module wurden zu zentralen
							Produkterweiterungen und kommen in vielen Deployments zum Einsatz.
						</li>
						<li>
							<strong>Observability neu aufgesetzt:</strong> Prometheus-Queries, Grafana-Dashboards und
							das Alerting samt Slack-Integration überarbeitet.
						</li>
						<li>
							<strong>Automatisierte Kubernetes-Migrationen:</strong> Python-Migrationsvorlagen für
							Control-Plane-Upgrades auf EKS, AKS und GKE erstellt. Aus einem manuellen, fehleranfälligen
							Prozess wurden automatisierte, wiederholbare Upgrades.
						</li>
						<li>
							<strong>Produktionssupport:</strong> Kunden bei Cluster-Optimierungen im Produktivbetrieb,
							beim Debuggen von Netzwerkproblemen und bei Infrastruktur-Troubleshooting unterstützt.
						</li>
						<li>
							<strong>ISO-27001-Konformität:</strong> Produktionsinfrastruktur und Sicherheitskontrollen
							analysiert und auf ISO-27001-Konformität gebracht.
						</li>
					</ul>

					<p class="mt-4">
						<strong>Tech-Stack:</strong> AWS, GCP, Azure, Kubernetes, Python, Prometheus, Grafana, Loki,
						MongoDB
					</p>
				</div>

				<!-- Facets.cloud - DevOps Intern -->
				<div class="border-accent-2 mb-12 border-l-4 pl-6">
					<h2 class="!mt-0">DevOps-Praktikant</h2>
					<p class="text-accent-2 mb-2 text-sm font-semibold">
						<a class="cactus-link" href="https://facets.cloud" rel="noreferrer" target="_blank"
							>Facets.cloud</a
						> • Remote-Praktikum
					</p>
					<p class="mb-4 text-sm italic">Februar 2023 – Juni 2023</p>

					<p>
						Praktikum im Platform-Team mit Kubernetes, Helm und produktiver Infrastruktur.
						Übernahme in die Festanstellung im Juni 2023.
					</p>

					<h3 class="text-base">Schwerpunkte:</h3>
					<ul class="list-inside list-disc space-y-2">
						<li>
							<strong>Helm-Chart-Entwicklung:</strong> Mehrere Helm-Charts als Produkterweiterungen
							entwickelt und veröffentlicht.
						</li>
						<li>
							<strong>Automatisierte Cluster-Effizienz:</strong> Einen Metrics-Scraper in Python gebaut,
							der eigene Prometheus-Metriken aus über 100 Kunden-Clustern parallel per Multithreading
							abruft. Das Tool analysierte Effizienz und Auslastung der Cluster und schlug Optimierungen
							vor.
						</li>
					</ul>

					<p class="mt-4">
						<strong>Tech-Stack:</strong> AWS, Python, Kubernetes, Helm, Terraform
					</p>
				</div>

				<!-- Opslyft - DevOps Intern -->
				<div class="border-accent-2 mb-12 border-l-4 pl-6">
					<h2 class="!mt-0">DevOps-Praktikant</h2>
					<p class="text-accent-2 mb-2 text-sm font-semibold">
						<a class="cactus-link" href="https://opslyft.com" rel="noreferrer" target="_blank"
							>Opslyft</a
						> • Remote-Praktikum
					</p>
					<p class="mb-4 text-sm italic">April 2022 – Februar 2023</p>

					<p>
						Erste DevOps-Rolle, bei einem Anbieter für Cloud-Kostenmanagement: Cloud-Migrationen,
						CI/CD und Kostenoptimierung.
					</p>

					<h3 class="text-base">Schwerpunkte:</h3>
					<ul class="list-inside list-disc space-y-2">
						<li>
							<strong>Modernisierungs-Migration:</strong> Einen klassischen, VM-basierten Legacy-Monolithen
							auf containerisierte Microservices in AWS ECS Fargate migriert. Außerdem das Logging von
							CloudWatch auf Loki mit Fluent-Bit-Sidecars umgestellt, was 30 % der gesamten Cloud-Kosten
							einsparte.
						</li>
						<li>
							<strong>CI/CD-Umstellung:</strong> Von Legacy-Jenkins-Pipelines auf GitHub Actions
							migriert und damit Geschwindigkeit und Wartbarkeit der CI/CD-Pipelines deutlich
							verbessert.
						</li>
					</ul>

					<p class="mt-4">
						<strong>Tech-Stack:</strong> AWS ECS Fargate, GitHub Actions, Jenkins CI/CD, AWS EventBridge
					</p>
				</div>

				<!-- Education -->
				<div class="border-accent-2 mt-16 border-t-2 pt-8">
					<h2>Ausbildung</h2>
					<div class="border-accent-2 border-l-4 pl-6">
						<h3 class="!mt-0">B.Tech. in Informatik</h3>
						<p class="text-accent-2 mb-2 text-sm font-semibold">
							SRMS CET, Bareilly • Angegliedert an die Abdul Kalam Technical University (A.K.T.U.)
						</p>
						<p class="text-sm italic">Juli 2019 – Juli 2023</p>
					</div>
				</div>
			</div>
		</Fragment>
	</LangBlock>
</PageLayout>
