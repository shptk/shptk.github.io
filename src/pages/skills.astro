---
import LangBlock from "@/components/LangBlock.astro";
import T from "@/components/T.astro";
import { t } from "@/i18n/ui";
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description:
		"Technical skills and expertise in Cloud, DevOps, Kubernetes, and Infrastructure automation",
	title: t("en", "page.skills"),
	titleDe: t("de", "page.skills"),
};

const skillCategories = [
	{
		title: "Programming & Scripting",
		titleDe: "Programmierung & Scripting",
		icon: "💻",
		skills: [
			{ name: "Python", level: "Advanced" },
			{ name: "Bash", level: "Advanced" },
			{ name: "Go", level: "Basic" },
		],
	},
	{
		title: "Infrastructure as Code",
		titleDe: "Infrastructure as Code",
		icon: "🏗️",
		skills: [
			{ name: "Terraform", level: "Expert" },
			{ name: "Ansible", level: "Advanced" },
			{ name: "Helm", level: "Advanced" },
		],
	},
	{
		title: "Cloud Platforms",
		titleDe: "Cloud-Plattformen",
		icon: "☁️",
		skills: [
			{ name: "AWS", level: "Advanced" },
			{ name: "Google Cloud Platform", level: "Advanced" },
			{ name: "Azure", level: "Advanced" },
		],
	},
	{
		title: "Container Orchestration",
		titleDe: "Container-Orchestrierung",
		icon: "🐳",
		skills: [
			{ name: "Kubernetes", level: "Expert" },
			{ name: "Docker", level: "Advanced" },
			{ name: "EKS / AKS / GKE", level: "Advanced" },
		],
	},
	{
		title: "CI/CD & Automation",
		titleDe: "CI/CD & Automatisierung",
		icon: "🔄",
		skills: [
			{ name: "GitHub Actions", level: "Advanced" },
			{ name: "Jenkins", level: "Intermediate" },
			{ name: "GitLab CI", level: "Intermediate" },
		],
	},
	{
		title: "Observability & Monitoring",
		titleDe: "Observability & Monitoring",
		icon: "📊",
		skills: [
			{ name: "Prometheus", level: "Advanced" },
			{ name: "Grafana", level: "Advanced" },
			{ name: "Loki", level: "Advanced" },
			{ name: "Telegraf", level: "Intermediate" },
		],
	},
	{
		title: "Databases",
		titleDe: "Datenbanken",
		icon: "🗄️",
		skills: [
			{ name: "MongoDB", level: "Intermediate" },
			{ name: "Redis", level: "Intermediate" },
			{ name: "MySQL / PostgreSQL", level: "Intermediate" },
		],
	},
	{
		title: "Core Concepts",
		titleDe: "Grundlagen",
		icon: "🧠",
		skills: [
			{ name: "System Design", level: "Advanced" },
			{ name: "Cloud Networking", level: "Advanced" },
			{ name: "Security & Compliance", level: "Intermediate" },
		],
	},
];

// Proficiency labels for the German fragment; the English fragment uses
// skill.level directly.
const LEVEL_DE: Record<string, string> = {
	Expert: "Experte",
	Advanced: "Fortgeschritten",
	Intermediate: "Mittel",
	Basic: "Grundkenntnisse",
};

// Bar width is derived from the level, so both fragments stay in sync.
const LEVEL_WIDTH: Record<string, string> = {
	Expert: "95%",
	Advanced: "80%",
	Intermediate: "60%",
	Basic: "40%",
};
---

<PageLayout meta={meta}>
	<h1 class="title mb-12"><T tKey="skills.heading" /></h1>
	<LangBlock>
		<Fragment slot="en">
			<div class="prose prose-sm prose-cactus max-w-none">
				<p class="mb-8 text-lg">
					My toolkit for building and scaling cloud-native infrastructure. From writing Terraform
					modules to debugging production Kubernetes clusters at 3 AM (yes, it happens).
				</p>

				<!-- Skills Grid -->
				<div class="not-prose mb-12 grid grid-cols-1 gap-6 md:grid-cols-2">
					{
						skillCategories.map((category) => (
							<div class="border-accent-2 rounded-lg border p-6 transition-shadow hover:shadow-lg">
								<div class="mb-4 flex items-center gap-3">
									<span class="text-3xl">{category.icon}</span>
									<h2 class="!mt-0 text-xl font-bold">{category.title}</h2>
								</div>
								<div class="space-y-3">
									{category.skills.map((skill) => (
										<div>
											<div class="mb-1 flex items-center justify-between">
												<span class="font-medium">{skill.name}</span>
												<span class="text-accent-2 text-xs font-semibold">{skill.level}</span>
											</div>
											<div class="bg-accent-2/20 h-2 w-full rounded-full">
												<div
													class="bg-accent-2 h-2 rounded-full transition-all"
													style={`width: ${skill.level === "Expert" ? "95%" : skill.level === "Advanced" ? "80%" : skill.level === "Intermediate" ? "60%" : "40%"}`}
												/>
											</div>
										</div>
									))}
								</div>
							</div>
						))
					}
				</div>

				<!-- What I'm Learning -->
				<div class="border-accent-2 mt-12 border-t-2 pt-8">
					<h2>Currently Exploring 🚀</h2>
					<p>
						The tech landscape never stops evolving, and neither do I! Here's what I'm currently
						diving into:
					</p>
					<ul class="list-inside list-disc space-y-2">
						<li>
							<strong>Golang:</strong> Getting hands-on with Go for building high-performance backend
							services and CLI tools
						</li>
						<li>
							<strong>System Design:</strong> Deep diving into distributed systems, scalability patterns,
							and architectural decision-making
						</li>
						<li>
							<strong>AI/ML Ops:</strong> Exploring how to apply DevOps principles to machine learning
							workflows and model deployment
						</li>
						<li>
							<strong>Platform Engineering:</strong> Building internal developer platforms and self-service
							infrastructure
						</li>
						<li>
							<strong>Service Mesh:</strong> Getting hands-on with Istio and Linkerd for advanced traffic
							management
						</li>
						<li>
							<strong>FinOps:</strong> Deep diving into cloud cost optimization strategies and FinOps
							best practices
						</li>
					</ul>
				</div>

				<!-- Approach -->
				<div class="border-accent-2 mt-12 border-t-2 pt-8">
					<h2>My Approach</h2>
					<p>
						I believe in <strong>infrastructure as code</strong>, <strong>automation first</strong>,
						and <strong>pragmatic solutions</strong> over perfect architectures. Every tool has its place,
						and the best technology is the one that solves your specific problem.
					</p>
					<p>
						Whether it's choosing between EKS, AKS, or GKE, or deciding if you even need Kubernetes
						in the first place, I focus on what works for your use case, not what's trending on tech
						Twitter.
					</p>
				</div>
			</div>
		</Fragment>
		<Fragment slot="de">
			<div class="prose prose-sm prose-cactus max-w-none">
				<p class="mb-8 text-lg">
					Mein Werkzeugkasten, um cloud-native Infrastruktur aufzubauen und zu skalieren — vom
					Schreiben von Terraform-Modulen bis zum Debuggen produktiver Kubernetes-Cluster um drei
					Uhr morgens. Ja, das kommt vor.
				</p>

				<!-- Skills Grid -->
				<div class="not-prose mb-12 grid grid-cols-1 gap-6 md:grid-cols-2">
					{
						skillCategories.map((category) => (
							<div class="border-accent-2 rounded-lg border p-6 transition-shadow hover:shadow-lg">
								<div class="mb-4 flex items-center gap-3">
									<span class="text-3xl">{category.icon}</span>
									<h2 class="!mt-0 text-xl font-bold">{category.titleDe}</h2>
								</div>
								<div class="space-y-3">
									{category.skills.map((skill) => (
										<div>
											<div class="mb-1 flex items-center justify-between">
												<span class="font-medium">{skill.name}</span>
												<span class="text-accent-2 text-xs font-semibold">
													{LEVEL_DE[skill.level] ?? skill.level}
												</span>
											</div>
											<div class="bg-accent-2/20 h-2 w-full rounded-full">
												<div
													class="bg-accent-2 h-2 rounded-full transition-all"
													style={`width: ${LEVEL_WIDTH[skill.level] ?? "40%"}`}
												/>
											</div>
										</div>
									))}
								</div>
							</div>
						))
					}
				</div>

				<!-- What I'm Learning -->
				<div class="border-accent-2 mt-12 border-t-2 pt-8">
					<h2>Womit ich mich gerade beschäftige 🚀</h2>
					<p>
						Die Tech-Landschaft entwickelt sich ständig weiter — ich auch. Daran arbeite ich
						aktuell:
					</p>
					<ul class="list-inside list-disc space-y-2">
						<li>
							<strong>Go:</strong> Praktische Erfahrung mit Go für performante Backend-Services und
							CLI-Tools
						</li>
						<li>
							<strong>System Design:</strong> Vertiefung in verteilte Systeme, Skalierungsmuster und
							Architekturentscheidungen
						</li>
						<li>
							<strong>AI/ML Ops:</strong> Wie sich DevOps-Prinzipien auf Machine-Learning-Workflows und
							Model-Deployment übertragen lassen
						</li>
						<li>
							<strong>Platform Engineering:</strong> Aufbau interner Developer-Plattformen und
							Self-Service-Infrastruktur
						</li>
						<li>
							<strong>Service Mesh:</strong> Praktische Arbeit mit Istio und Linkerd für
							fortgeschrittenes Traffic-Management
						</li>
						<li>
							<strong>FinOps:</strong> Strategien zur Cloud-Kostenoptimierung und FinOps-Best-Practices
						</li>
					</ul>
				</div>

				<!-- Approach -->
				<div class="border-accent-2 mt-12 border-t-2 pt-8">
					<h2>Meine Herangehensweise</h2>
					<p>
						Ich setze auf <strong>Infrastructure as Code</strong>, <strong>Automatisierung zuerst</strong>
						und <strong>pragmatische Lösungen</strong> statt perfekter Architekturen. Jedes Werkzeug hat
						seinen Platz, und die beste Technologie ist die, die das konkrete Problem löst.
					</p>
					<p>
						Ob es um die Wahl zwischen EKS, AKS und GKE geht oder um die Frage, ob Kubernetes
						überhaupt nötig ist: Entscheidend ist, was zum jeweiligen Anwendungsfall passt — nicht,
						was gerade Trend ist.
					</p>
				</div>
			</div>
		</Fragment>
	</LangBlock>
</PageLayout>
